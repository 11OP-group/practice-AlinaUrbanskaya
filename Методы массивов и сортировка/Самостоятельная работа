prices_str = '100 50 200 150 75 300'

list_prices = prices_str.split()
print(f"Разбитая строка на список цен: {list_prices}")

int_list_prices = [int(x) for x in list_prices]
print(f"Преобразованная строка в числа: {int_list_prices}")

mx = max(int_list_prices)
print(f"Самый дорогой товар в списке: {mx}")

int_list_prices.remove(mx)
print(f"Список без дорого товара: {int_list_prices}")

skidka = mx//2
int_list_prices.append(skidka)
print(f"Список с новым добавленным товаром (50% от максимума): {int_list_prices}")

int_list_prices.sort()
print(f"Отсортированный список от меньш. к больш.: {int_list_prices}")

print(f"Средняя цена: {sum(int_list_prices)/len(int_list_prices)}")
