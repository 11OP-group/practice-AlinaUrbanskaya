print("Чтобы выйти из программы, напишите число меньшее 1.")

num = 1 #присваиваем num число>0, чтобы while (на строчке 5) работал корректно
massive = []
while num>0:
    num = int(input("Введите число >0: "))
    if num%2 != 0: #если число нечётное...
        massive.append(num)
else:
    print(f"Список нечётных чисел: {massive}")
