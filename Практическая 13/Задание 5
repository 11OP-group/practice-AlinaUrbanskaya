nums = list(map(int, input("Введите целые числа: ").split(" "))) #каждое все числа разбиваем на список (list), переводим в int (функция int и map)
c = 0 #кол-во пар равных чисел

for i in range(len(nums)-1): #перебираем все пары чисел, отнимаем 1 - чтобы не был выход за границы списка (массива)
    if nums[i] == nums[i+1]: #если левое число равно правому (пара чисел), +1 к переменной с (строка 6)
        c+=1 #похоже на 17 задание из егэ по инф xdddd
print(f"Кол-во равных пар: {c}")
